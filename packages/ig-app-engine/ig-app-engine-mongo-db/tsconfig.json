{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "lib": ["ESNext"],
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "experimentalDecorators": true,
    "allowImportingTsExtensions": true,
    "types": ["vitest/globals"],
    "paths": {
      "@/*": ["./src/*"],
      "@ig/app-engine-models/test-utils": ["../ig-app-engine-models/test/test-index.ts"],
    }
  }
}
