{
  "name": "ig-expo",
  "main": "index.ts",
  "version": "1.0.0",
  "scripts": {
    "build": "echo nothing to do",
    "test": "npm run build && npm run tsc && npm run lint && npm run cover:unit",
    "tsc": "npx tsc",
    "lint": "npm run lint:eslint && npm run lint:cycles",
    "lint:eslint": "expo lint ./src",
    "lint:fix": "npm run lint:eslint -- --fix",
    "lint:cycles": "madge --circular --extensions ts,tsx,js .",
    "test:unit": "echo ok",
    "ut": "npm run test:unit --",
    "test:verbose": "echo ok",
    "cover:unit": "npm run test:unit -- run --coverage",
    "start": "expo start",
    "start:clean": "expo start -c",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/metro-config": "~55.0.22",
    "@ig/app-engine-ui": "*",
    "@ig/auth-ui": "*",
    "@ig/env": "*",
    "@ig/games-engine-ui": "*",
    "@ig/games-engine-ui-models": "*",
    "dotenv": "^16.6.1",
    "expo": "~55.0.25",
    "expo-constants": "~55.0.16",
    "expo-router": "~55.0.15",
    "expo-splash-screen": "~55.0.21",
    "expo-status-bar": "~55.0.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@ig/lint": "*",
    "@types/react": "~19.1.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
